# Copy to .env.appwrite (do not commit secrets)
# Create project + API key in Appwrite Console first.

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=most

# API key scopes (Console → API Keys → edit key):
#   databases.read, databases.write
#   tables.read, tables.write          <-- required (TablesDB / Cloud 1.8+)
#   columns.read, columns.write        <-- if listed in your Console
#   rows.read, rows.write              <-- for --seed
#   buckets.read, buckets.write
#   files.read, files.write
#   functions.read, functions.write
# Legacy "collections.*" alone is NOT enough on current Cloud.
